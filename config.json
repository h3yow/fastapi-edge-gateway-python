{
  "routes": [
    {
      "path_prefix": "/api/orders",
      "upstreams": [
        {"name": "orders-1", "base_url": "http://127.0.0.1:9001"},
        {"name": "orders-2", "base_url": "http://127.0.0.1:9002"}
      ],
      "rate_limit": {"rate_per_second": 5.0, "burst": 10, "max_concurrency": 5},
      "cache": {"enabled": true, "ttl_seconds": 30.0, "max_entries": 128},
      "retry": {"max_attempts": 2, "timeout_seconds": 2.0}
    },
    {
      "path_prefix": "/api/payments",
      "upstreams": [
        {"name": "payments-1", "base_url": "http://127.0.0.1:9003"}
      ],
      "rate_limit": {"rate_per_second": 2.0, "burst": 3, "max_concurrency": 2},
      "cache": {"enabled": false, "ttl_seconds": 30.0, "max_entries": 128},
      "retry": {"max_attempts": 1, "timeout_seconds": 1.0}
    }
  ]
}
